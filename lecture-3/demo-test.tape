# ── VHS Demo Tape ─────────────────────────────────────────────────────────────
Output demo.mp4

Set FontSize 48
Set Width 1700
Set Height 2200
Set Theme "Pro"
Set TypingSpeed 80ms

Sleep 3s

# ── Start Julia ───────────────────────────────────────────────────────────────
Type "julia --project"
Enter
Sleep 3s
